#!/usr/bin/expect -f
# When :8080 is held, the viewer binds the next free candidate and the REPL
# announces that one; the session runs as usual and exits cleanly, and the
# server child goes with it.
source [file join [file dirname [info script]] lib.exp]
if {[port_8080_busy]} { puts "SKIP-as-pass: :8080 busy before spawn"; exit 0 }
# Hold the port.  IPv4 on every interface, the address the viewer binds.
proc refuse {chan addr port} { close $chan }
if {[catch {socket -server refuse -myaddr 0.0.0.0 8080} holder]} {
    puts "FAIL: could not hold :8080: $holder"
    exit 1
}
spawn_logo_session
expect {
    -re {viewer: http://localhost:([0-9]+)} {
        set port $expect_out(1,string)
    }
    "viewer: not started" {
        puts "FAIL: the viewer was not started"
        kill_session_tree
        exit 1
    }
    timeout { puts "FAIL: no announcement"; kill_session_tree; exit 1 }
    eof { puts "FAIL: died at spawn"; exit 1 }
}
if {$port == 8080} {
    puts "FAIL: announced the held port 8080"
    kill_session_tree
    exit 1
}
expect {
    -re {\? } {}
    timeout { puts "FAIL: no prompt"; kill_session_tree; exit 1 }
    eof { puts "FAIL: died before the prompt"; exit 1 }
}
assert_alive 7 6 13
ctrl_d
expect {
    eof {}
    timeout { puts "FAIL: still alive after ctrl-d"; kill_session_tree; exit 1 }
}
catch {wait} result
if {![exited_zero $result]} { puts "FAIL: not a clean exit 0: $result"; exit 1 }
close $holder
# Nothing of the session may outlive it: the exit hook stops the server
# child, so the process group empties with the session leader.
for {set i 0} {$i < 25} {incr i} {
    if {[catch {exec kill -0 -- "-$spawn_pid"}]} { exit 0 }
    after 200
}
puts "FAIL: the session's process group outlived it"
kill_session_tree
exit 1
